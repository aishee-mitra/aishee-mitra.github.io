# Copy to .env and fill in -- do NOT commit .env (gitignored)
BLOG_MODEL="google/gemma-4-31b-it"
BLOG_PROVIDER=""

# Composer model/provider (default: Gemma-4-31b-it via OpenRouter)
BLOG_COMPOSER_MODEL="google/gemma-4-31b-it"
BLOG_COMPOSER_PROVIDER="openrouter"
# Worker model/provider (default: Nemotron 3.5 Lightning via OpenRouter)
BLOG_WORKER_MODEL="nvidia/nemotron-3.5-lightning:free"
BLOG_WORKER_PROVIDER="openrouter"

# BLOG_FEWSHOT_COUNT="3"   # number of recent posts to inject as style examples (default: 3, 0 = disable)
